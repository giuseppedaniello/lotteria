rules_version = '2';

// Regole di sicurezza di Firestore per la Lotteria dei cesti.
// Da incollare in console.firebase.google.com → Firestore Database → Regole → Pubblica.
// Ogni utente può leggere e scrivere solo i dati sotto users/{il suo uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
